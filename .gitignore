/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/pdf-tools/
/tmp/pdfs/
/output/pdf/

# next.js
/.next/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code local state
.claude/worktrees/
.claude/settings.local.json

# PNG masters handed over for ingest (npm run ingest); only optimized webp ships
/product

# About source uploads; the site uses optimized copies in public/about/journey
/public/about/3D Showreel/
/public/about/ai video/
/public/about/ai creative/
/public/about/America/
/public/about/Me/
/public/about/prtflo-cv-draft.pdf

